<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<!-- xUnit.net v3 test projects must be executable; the runner
		     generates the entry point. -->
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!--
			CA1707 (no underscores in member names) is the xUnit-naming
			convention everyone uses for readable test names like
			Method_WhenCondition_ExpectedResult. Let tests use it.

			CA1515 (internal > public) would flag every xUnit fixture —
			tests need to be public for the runner to discover them.

			CA2007 (ConfigureAwait) doesn't apply in test contexts; there
			is no SynchronizationContext to recapture.
		-->
		<NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\NextIteration.SpectreConsole.Auth\NextIteration.SpectreConsole.Auth.csproj" />
	</ItemGroup>

</Project>
